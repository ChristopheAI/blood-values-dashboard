          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="eAppDomain" value="calls pure rules" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="appLayer" target="domainLayer">
